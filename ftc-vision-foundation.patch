@@ -0,0 +1,52 @@
+package org.firstinspires.ftc.teamcode.vision;
+
+import com.qualcomm.robotcore.eventloop.opmode.LinearOpMode;
+import com.qualcomm.robotcore.eventloop.opmode.TeleOp;
+import org.firstinspires.ftc.vision.apriltag.AprilTagSingleDetection;
+
+import java.util.List;
+
+/** Read-only camera test. Does not actuate motors or servos. */
+@TeleOp(name = "Vision: Recognition Test", group = "Vision")
+public class VisionDebugOpMode extends LinearOpMode {
+    @Override
+    public void runOpMode() {
+        VisionSubsystem vision = new VisionSubsystem(hardwareMap);
+        try {
+            telemetry.addLine("Webcam initialized. Press START for detections.");
+            telemetry.addLine("Camera stream: Driver Station > menu > Camera Stream");
+            telemetry.update();
+            waitForStart();
+
+            while (opModeIsActive()) {
+                TargetDetection target = vision.findLargestColorTarget();
+                if (target == null) {
+                    telemetry.addData("Color target", "none");
+                } else {
+                    telemetry.addData("Color target", target.getLabel());
+                    telemetry.addData("Center (px)", "%.0f, %.0f",
+                            target.getCenterXPx(), target.getCenterYPx());
+                    telemetry.addData("Area (px^2)", target.getAreaPx());
+                    telemetry.addData("Horizontal error", "%.2f",
+                            target.getHorizontalError());
+                }
+
+                List<AprilTagSingleDetection> tags = vision.getAprilTags();
+                telemetry.addData("AprilTags", tags.size());
+                for (int index = 0; index < Math.min(3, tags.size()); index++) {
+                    AprilTagSingleDetection tag = tags.get(index);
+                    String name = tag.metadata != null ? tag.metadata.name : "unknown";
+                    telemetry.addData("Tag " + tag.id, name);
+                    if (tag.ftcPose != null) {
+                        telemetry.addData("Tag " + tag.id + " range (in)",
+                                "%.1f", tag.ftcPose.range);
+                    }
+                }
+                telemetry.update();
+                sleep(75);
+            }
+        } finally {
+            vision.close();
+        }
+    }
+}
diff --git a/TeamCode/src/main/java/org/firstinspires/ftc/teamcode/vision/VisionSubsystem.java b/TeamCode/src/main/java/org/firstinspires/ftc/teamcode/vision/VisionSubsystem.java
new file mode 100644
index 0000000..d162b3f
--- /dev/null
+++ b/TeamCode/src/main/java/org/firstinspires/ftc/teamcode/vision/VisionSubsystem.java
@@ -0,0 +1,86 @@
+package org.firstinspires.ftc.teamcode.vision;
+
+import android.util.Size;
+import com.qualcomm.robotcore.hardware.HardwareMap;
+import org.firstinspires.ftc.robotcore.external.hardware.camera.WebcamName;
+import org.firstinspires.ftc.vision.VisionPortal;
+import org.firstinspires.ftc.vision.apriltag.AprilTagDetection;
+import org.firstinspires.ftc.vision.apriltag.AprilTagProcessor;
+import org.firstinspires.ftc.vision.apriltag.AprilTagSingleDetection;
+import org.firstinspires.ftc.vision.opencv.ColorBlobLocatorProcessor;
+import org.firstinspires.ftc.vision.opencv.ImageRegion;
+import org.opencv.core.RotatedRect;
+
+import java.util.ArrayList;
+import java.util.List;
+
+/**
+ * Owns one webcam and two FTC SDK processors: color blob detection and AprilTags.
+ * Construct once per OpMode; call close() when the OpMode finishes.
+ */
+public final class VisionSubsystem implements AutoCloseable {
+    private final ColorBlobLocatorProcessor colorProcessor;
+    private final AprilTagProcessor aprilTagProcessor;
+    private final VisionPortal portal;
+
+    public VisionSubsystem(HardwareMap hardwareMap) {
+        colorProcessor = new ColorBlobLocatorProcessor.Builder()
+                .setTargetColorRange(VisionConfig.TARGET_COLOR)
+                .setContourMode(ColorBlobLocatorProcessor.ContourMode.EXTERNAL_ONLY)
+                .setRoi(ImageRegion.entireFrame())
+                .setDrawContours(false)
+                .setBlurSize(5)
+                .build();
+
+        aprilTagProcessor = AprilTagProcessor.easyCreateWithDefaults();
+
+        portal = new VisionPortal.Builder()
+                .setCamera(hardwareMap.get(WebcamName.class, VisionConfig.WEBCAM_NAME))
+                .setCameraResolution(new Size(
+                        VisionConfig.FRAME_WIDTH_PX, VisionConfig.FRAME_HEIGHT_PX))
+                .addProcessor(colorProcessor)
+                .addProcessor(aprilTagProcessor)
+                .build();
+    }
+
+    /** Returns the largest sufficiently big color region, or null if none is found. */
+    public TargetDetection findLargestColorTarget() {
+        ColorBlobLocatorProcessor.Blob best = null;
+        int bestArea = VisionConfig.MIN_BLOB_AREA_PX - 1;
+
+        for (ColorBlobLocatorProcessor.Blob blob : colorProcessor.getBlobs()) {
+            int area = blob.getContourArea();
+            if (area >= VisionConfig.MIN_BLOB_AREA_PX && area > bestArea) {
+                best = blob;
+                bestArea = area;
+            }
+        }
+        if (best == null) {
+            return null;
+        }
+
+        RotatedRect boundingBox = best.getBoxFit();
+        return new TargetDetection(
+                VisionConfig.TARGET_LABEL,
+                boundingBox.center.x,
+                boundingBox.center.y,
+                best.getContourArea(),
+                VisionConfig.FRAME_WIDTH_PX);
+    }
+
+    /** Returns individual tags; SDK 12 also supports multi-tag cluster detections. */
+    public List<AprilTagSingleDetection> getAprilTags() {
+        List<AprilTagSingleDetection> tags = new ArrayList<>();
+        for (AprilTagDetection detection : aprilTagProcessor.getDetections()) {
+            if (detection instanceof AprilTagSingleDetection) {
+                tags.add((AprilTagSingleDetection) detection);
+            }
+        }
+        return tags;
+    }
+
+    @Override
+    public void close() {
+        portal.close();
+    }
+}
